{"version":"0.0.1","configurations":[{"name":"omix","runtimeExecutable":"powershell","runtimeArgs":["-Command","$l=New-Object System.Net.HttpListener;$l.Prefixes.Add('http://localhost:3700/');$l.Start();while($l.IsListening){$c=$l.GetContext();try{$p=$c.Request.Url.LocalPath-replace'^/','';if($p-eq''){$p='index.html'};$f=Join-Path 'C:\\Users\\roh28\\Desktop\\OMIX\\3' $p;$r=$c.Response;if(Test-Path $f -PathType Leaf){$b=[System.IO.File]::ReadAllBytes($f);$e=[System.IO.Path]::GetExtension($f);$r.ContentType=switch($e){'.html'{'text/html'}'.css'{'text/css'}'.js'{'application/javascript'}'.png'{'image/png'}'.svg'{'image/svg+xml'}default{'application/octet-stream'}};$r.ContentLength64=$b.Length;$r.OutputStream.Write($b,0,$b.Length)}else{$r.StatusCode=404;$r.ContentLength64=0};$r.OutputStream.Close()}catch{try{$c.Response.OutputStream.Close()}catch{}}}"],"port":3700}]}
